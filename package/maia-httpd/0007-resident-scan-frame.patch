+        struct Mock{data:RefCell<[u32;64]>,writes:RefCell<Vec<(usize,u32)>>}
+        impl Registers for Mock{fn read(&self,o:usize)->u32{self.data.borrow()[o/4]}fn write(&self,o:usize,v:u32){self.writes.borrow_mut().push((o,v));}}
