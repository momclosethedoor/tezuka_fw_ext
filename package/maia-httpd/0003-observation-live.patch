+//! Explicit synthetic transport exerciser. Never opens DMA/IIO or controls RF.
+//! This is not a native PL producer and is not started by maia-httpd.
+#![allow(dead_code)]
+#[path="../observation.rs"] mod observation;
+#[path="../observation_live.rs"] mod observation_live;
+use observation::{Descriptor,Observation,NO_TAG};
+use observation_live::{Cursor,Encoder,Fanout};
+use std::io::{self,Write};
+use std::net::{TcpListener,TcpStream};
+use std::sync::{Arc,atomic::{AtomicBool,Ordering}};
+use std::thread::{self,JoinHandle};
+use std::time::{Duration,Instant};
+
+#[derive(Default)]struct ClientResult{sent:u64,missed:u64,partial_disconnects:u64,errors:u64}
+fn serve(mut socket:TcpStream,hub:Arc<Fanout>,mut cursor:Cursor,header:Arc<Vec<u8>>,done:Arc<AtomicBool>,max:usize)->ClientResult{
+    let mut result=ClientResult::default();
+    let mut pending=Vec::with_capacity(max.max(header.len()));pending.extend_from_slice(&header);let mut offset=0;let mut record=false;let mut drain=None;
+    if socket.set_nonblocking(true).is_err(){result.errors=1;return result;}
+    let _=socket.set_nodelay(true);
+    loop {
+        if done.load(Ordering::Acquire) && drain.is_none(){drain=Some(Instant::now());}
+        if drain.is_some_and(|t|t.elapsed()>Duration::from_secs(15)){if offset!=0 && offset<pending.len(){result.partial_disconnects+=1;}result.errors+=1;break;}
+        if offset==pending.len(){
+            if record{result.sent+=1;record=false;}
+            if hub.poll(&mut cursor,&mut pending){offset=0;record=true;}
+            else if done.load(Ordering::Acquire){break;}
+            else{thread::sleep(Duration::from_millis(1));continue;}
+        }
+        match socket.write(&pending[offset..]){
+            Ok(0)=>{result.errors+=1;if offset!=0{result.partial_disconnects+=1;}break;},
+            Ok(n)=>offset+=n,
+            Err(e) if e.kind()==io::ErrorKind::WouldBlock=>thread::sleep(Duration::from_millis(1)),
+            Err(e) if e.kind()==io::ErrorKind::Interrupted=>{},
+            Err(_)=>{result.errors+=1;if offset!=0{result.partial_disconnects+=1;}break;}
+        }
+    }
+    result.missed=cursor.missed;result
+}
+fn main(){if let Err(e)=run(){eprintln!("{e}");std::process::exit(1);}}
+fn run()->Result<(),Box<dyn std::error::Error>>{
+    let args:Vec<String>=std::env::args().skip(1).collect();
+    if !args.iter().any(|s|s=="--synthetic"){return Err("SYNTHETIC ONLY: --synthetic and --capture-id UUID required; no hardware fallback".into());}
+    let value=|key:&str,default:&str|->String{args.iter().position(|s|s==key).map(|i|args.get(i+1).expect("missing option value").clone()).unwrap_or_else(||default.into())};
+    let known=["--capture-id","--bind","--seconds","--rate","--bins","--queue","--clients","--wait-clients","--context-every","--unclean-every"];
+    let mut i=0;while i<args.len(){if args[i]=="--synthetic"{i+=1;}else if known.contains(&args[i].as_str()) && i+1<args.len(){i+=2;}else{return Err(format!("unknown/missing argument {}",args[i]).into());}}
+    let id=value("--capture-id","").replace('-',"");
+    if id.len()!=32{return Err("explicit fresh capture UUID is required".into());}
+    let mut session=[0;16];for (i,x) in session.iter_mut().enumerate(){*x=u8::from_str_radix(&id[2*i..2*i+2],16)?;}
+    let seconds:f64=value("--seconds","30").parse()?;let rate:f64=value("--rate","1000").parse()?;
+    let bins:u32=value("--bins","4096").parse()?;let capacity:usize=value("--queue","8").parse()?;let clients:usize=value("--clients","2").parse()?;let wait:usize=value("--wait-clients","0").parse()?;
+    let context:u64=value("--context-every","10000").parse()?;let unclean:u64=value("--unclean-every","0").parse()?;
+    if !seconds.is_finite() || !(0.01..=240.).contains(&seconds) || !rate.is_finite() || !(1.0..=100000.).contains(&rate) || !(1..=8).contains(&clients) || wait>clients || context==0{return Err("duration/rate/clients/context bounds".into());}
+    let ds=(1..=2).map(|id|Descriptor{id,sample_rate:4e6,bin0_hz:id as f64*100e6,enbw_bins:1.5,tick_hz:4_000_000,bins,mode:1,source:1}).collect();
+    let mut encoder=Encoder::new_nint1(session,ds)?;let max=encoder.max_record();let header=Arc::new(encoder.header().to_vec());
+    let hub=Arc::new(Fanout::new(capacity,max)?);let done=Arc::new(AtomicBool::new(false));
+    let listener=TcpListener::bind(value("--bind","127.0.0.1:0"))?;listener.set_nonblocking(true)?;
+    println!("SYNTHETIC ONLY; no PL/DMA/RF access");println!("READY {}",listener.local_addr()?);io::stdout().flush()?;
+    let mut workers:Vec<Option<JoinHandle<ClientResult>>>=(0..clients).map(|_|None).collect();let mut total=ClientResult::default();let mut accepted=0u64;let mut rejected=0u64;
+    let mut accept=|workers:&mut Vec<Option<JoinHandle<ClientResult>>>|->io::Result<()> {
+        for slot in workers.iter_mut(){if slot.as_ref().is_some_and(|h|h.is_finished()){let r=slot.take().unwrap().join().expect("sender panic");total.sent+=r.sent;total.missed+=r.missed;total.errors+=r.errors;total.partial_disconnects+=r.partial_disconnects;}}
+        // Bounded work per acquisition turn, even during a connection flood.
+        for _ in 0..8{match listener.accept(){
+            Ok((socket,_))=>{if let Some(slot)=workers.iter_mut().find(|s|s.is_none()){let (q,h,d)=(hub.clone(),header.clone(),done.clone());let cursor=q.subscribe();*slot=Some(thread::spawn(move||serve(socket,q,cursor,h,d,max)));accepted+=1;}else{rejected+=1;}},
+            Err(e) if e.kind()==io::ErrorKind::WouldBlock=>break,Err(e)=>return Err(e)
+        }}Ok(())
+    };
+    let waiting=Instant::now();
+    while workers.iter().filter(|s|s.is_some()).count()<wait{accept(&mut workers)?;if waiting.elapsed()>Duration::from_secs(15){return Err("synthetic startup client timeout".into());}thread::sleep(Duration::from_millis(1));}
+    let start=Instant::now();let mut frame=Vec::with_capacity(max);let mut o=Observation{descriptor_id:1,seq:0,epoch:1,first_tick:0,nint:1,tag:NO_TAG,power:vec![0.;bins as usize]};
+    let mut produced=0u64;
+    while start.elapsed().as_secs_f64()<seconds{
+        accept(&mut workers)?;
+        let due=produced as f64/rate;let elapsed=start.elapsed().as_secs_f64();
+        if due>elapsed{thread::sleep(Duration::from_secs_f64((due-elapsed).min(0.001)));continue;}
+        o.seq=produced;o.epoch=1+produced/context;o.descriptor_id=1+((o.epoch-1)%2) as u16;o.first_tick=produced.checked_mul(bins as u64).ok_or("synthetic tick overflow")?;
+        if unclean!=0 && produced%unclean==0{o.epoch=0;}
+        for (k,x) in o.power.iter_mut().enumerate(){*x=((produced%1024)*16+k as u64%16) as f32/16384.;}
+        encoder.observation(&o,&mut frame)?;hub.publish(&frame)?;produced+=1;
+    }
+    drop(accept);done.store(true,Ordering::Release);
+    for h in workers.into_iter().flatten(){let r=h.join().map_err(|_|"sender panic")?;total.sent+=r.sent;total.missed+=r.missed;total.errors+=r.errors;total.partial_disconnects+=r.partial_disconnects;}
+    println!("{{\"source\":\"synthetic\",\"produced\":{produced},\"published\":{},\"contention_drops\":{},\"client_missed\":{},\"sent_records\":{},\"accepted\":{accepted},\"rejected\":{rejected},\"partial_disconnects\":{},\"sender_errors\":{},\"queue_payload_capacity\":{},\"frame_capacity\":{},\"power_capacity\":{},\"max_clients\":{clients},\"seconds\":{}}}",hub.published(),hub.contention_drops.load(Ordering::Relaxed),total.missed,total.sent,total.partial_disconnects,total.errors,hub.allocated_payload_bytes(),frame.capacity(),o.power.capacity(),start.elapsed().as_secs_f64());
+    Ok(())
+}
