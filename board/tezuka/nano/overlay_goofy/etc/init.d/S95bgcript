#!/bin/sh
# Копия board/tezuka/common/overlay_tezuka/etc/init.d/S95bgcript (v0.3.24) для оверлея goofy nano (PL-4a):
# единственное отличие — не запускается /mnt/jffs2/backdoor.sh (чужой скрипт из jffs2).

start() {
# goofy (PL-4a): /mnt/jffs2/backdoor.sh не выполняется
[ -f /mnt/jffs2/backdoor.sh ] && logger -t goofy "S95bgcript: /mnt/jffs2/backdoor.sh есть, НЕ выполняется"

/root/lnb_config.sh </dev/null 2>/dev/null
/root/watchconsoletx.sh </dev/null 2>/dev/null &
/root/watchdatveasy.sh </dev/null 2>/dev/null &
/root/watchconsolefreq.sh </dev/null 2>/dev/null &
/root/api_controller.sh </dev/null 2>/dev/null &
# /root/adj_chrony.sh </dev/null 2>/dev/null &
export HISTFILE="/mnt/jffs2/ash_history"

}

stop() {

	echo "Stopping"
}

restart() {
	stop
	start
}

# start/stop/restart
case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?


